<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\brukerlogo.ico</ApplicationIcon>
    <StartupObject>BackgroundTuner.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\brukerlogo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BrukerAXS.IO.SimpleBrmlReader.Xrf" Version="12.0.1" />
  </ItemGroup>

</Project>

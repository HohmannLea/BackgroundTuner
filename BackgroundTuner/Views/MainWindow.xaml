<Window x:Class="BackgroundTuner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Theoretical Background Tuner"
        Icon="/Assets/brukerlogo.ico"
        Height="450"
        Width="400">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Solution file to be edited"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Button Content="Choose file..."
                    Width="120"
                    Margin="0,0,0,8"
                    Command="{Binding LoadBsmlCommand}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="⚠"
                           Foreground="DarkOrange"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding BsmlStatusText}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Blank Measurements"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <TextBlock Text="Master Blank"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <Button Content="Choose file..."
                    Width="120"
                    Margin="0,0,0,8"
                    Command="{Binding LoadBrmlCommand}"
                    CommandParameter="MasterBlank" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="⚠"
                           Foreground="DarkOrange"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding MasterBlankStatusText}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Current Blank"
                       FontSize="13"
                       FontWeight="SemiBold" />

            <Button Content="Choose file..."
                    Width="120"
                    Margin="0,0,0,8"
                    Command="{Binding LoadBrmlCommand}"
                    CommandParameter="CurrentBlank" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="⚠"
                           Foreground="DarkOrange"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentBlankStatusText}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Tune theoretical background"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Button Content="Recalculate"
                    Width="120"
                    Margin="0,0,0,8"
                    Command="{Binding RecalculateCommand}" />
        </StackPanel>
        
    </Grid>
</Window>

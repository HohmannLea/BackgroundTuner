<Window x:Class="BackgroundTuner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackgroundTuner"
        mc:Ignorable="d"
        Title="Theoretical Background Tuner"
        Height="450"
        Width="800">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Solution file to be edited"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Button Content="Choose file..."
                    Width="120"
                    Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="⚠"
                           Foreground="DarkOrange"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="No file selected"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Blank Measurements"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <TextBlock Text="Master Blank"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <Button Content="Choose file..."
                    Width="120"
                    Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="⚠"
                           Foreground="DarkOrange"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="No file selected"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Current Blank"
                       FontSize="13"
                       FontWeight="SemiBold" />
            
            <Button Content="Choose file..."
                    Width="120"
                    Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="⚠"
                           Foreground="DarkOrange"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="No file selected"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Tune theoretical background"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Button Content="Recalculate"
                    Width="120"
                    Margin="0,0,0,8" />

        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        </Grid>
    </Grid>
</Window>
